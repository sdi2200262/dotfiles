{
  "manifest_version": 2,
  "name": "Gruvbox Dark Soft",
  "version": "1.0",
  "description": "Gruvbox dark soft, matching Ghostty, Herdr and sway (dotfiles).",
  "browser_specific_settings": { "gecko": { "id": "gruvbox-soft@dotfiles" } },
  "theme": {
    "colors": {
      "frame": "#32302f",
      "frame_inactive": "#32302f",
      "tab_background_text": "#a89984",
      "tab_selected": "#504945",
      "tab_text": "#ebdbb2",
      "tab_line": "#fabd2f",
      "tab_loading": "#fabd2f",
      "toolbar": "#3c3836",
      "toolbar_text": "#ebdbb2",
      "toolbar_top_separator": "#32302f",
      "toolbar_bottom_separator": "#282828",
      "toolbar_vertical_separator": "#504945",
      "toolbar_field": "#32302f",
      "toolbar_field_text": "#ebdbb2",
      "toolbar_field_border": "#504945",
      "toolbar_field_focus": "#32302f",
      "toolbar_field_text_focus": "#ebdbb2",
      "toolbar_field_border_focus": "#fabd2f",
      "toolbar_field_highlight": "#fabd2f",
      "toolbar_field_highlight_text": "#282828",
      "icons": "#ebdbb2",
      "icons_attention": "#fabd2f",
      "button_background_hover": "#504945",
      "button_background_active": "#665c54",
      "popup": "#3c3836",
      "popup_text": "#ebdbb2",
      "popup_border": "#504945",
      "popup_highlight": "#504945",
      "popup_highlight_text": "#ebdbb2",
      "sidebar": "#32302f",
      "sidebar_text": "#ebdbb2",
      "sidebar_border": "#504945",
      "sidebar_highlight": "#504945",
      "sidebar_highlight_text": "#ebdbb2",
      "ntp_background": "#32302f",
      "ntp_card_background": "#3c3836",
      "ntp_text": "#ebdbb2"
    },
    "properties": { "color_scheme": "dark", "content_color_scheme": "dark" }
  }
}
