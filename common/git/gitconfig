[user]
	name = CobuterMan
	email = haidemenoss@gmail.com
[init]
	defaultBranch = main
[core]
	pager = delta
[interactive]
	difffilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	wrap-max-lines = unlimited
	features = gruvbox-dark-soft
	syntax-theme = gruvbox-dark
[delta "gruvbox-dark-soft"]
	dark = true
	minus-style = "syntax #3c1f1e"
	minus-non-emph-style = "syntax #3c1f1e"
	minus-emph-style = "syntax #5e2a29"
	minus-empty-line-marker-style = "syntax #3c1f1e"
	line-numbers-minus-style = "#fb4934"
	plus-style = "syntax #1e2d1c"
	plus-non-emph-style = "syntax #1e2d1c"
	plus-emph-style = "syntax #2d4127"
	plus-empty-line-marker-style = "syntax #1e2d1c"
	line-numbers-plus-style = "#b8bb26"
	line-numbers-zero-style = "#504945"
	line-numbers-left-style = "#665c54"
	line-numbers-right-style = "#665c54"
	file-style = "#fabd2f bold"
	file-decoration-style = "#665c54 ul"
	hunk-header-style = "#83a598 bold"
	hunk-header-decoration-style = "#665c54 box"
	hunk-header-file-style = "#d3869b"
	hunk-header-line-number-style = "#fabd2f"
	zero-style = syntax
	whitespace-error-style = "#fb4934 reverse"
	blame-palette = "#32302f #3c3836 #504945 #665c54"
[merge]
	conflictstyle = zdiff3
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
# Per-machine settings (credential helpers etc.) live outside the repo.
[include]
	path = ~/.gitconfig.local
